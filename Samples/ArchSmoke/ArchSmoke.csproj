<Project Sdk="Microsoft.NET.Sdk">

  <!-- 指令集冒烟：宿主构建 IL，目标架构运行时执行（riscv64 / s390x QEMU） -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ArchSmoke</AssemblyName>
    <RootNamespace>ArchSmoke</RootNamespace>
    <AssemblyTitle>蚂蚁调度指令集冒烟</AssemblyTitle>
    <Description>在目标架构运行时上加载主库并执行核心 API，验证指令集兼容性。</Description>
    <Company>新生命开发团队</Company>
    <Copyright>版权所有(C) 新生命开发团队 2026</Copyright>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AntJob/AntJob.csproj" />
  </ItemGroup>

</Project>
