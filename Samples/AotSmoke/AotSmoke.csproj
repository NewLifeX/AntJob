<Project Sdk="Microsoft.NET.Sdk">

  <!-- NativeAOT 冒烟：以 PublishAot 发布后运行，验证核心库、扩展库与数据模型在裁剪后仍可用 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AotSmoke</AssemblyName>
    <RootNamespace>AotSmoke</RootNamespace>
    <AssemblyTitle>蚂蚁调度 AOT 冒烟</AssemblyTitle>
    <Description>以 NativeAOT 发布并执行核心 API，验证 AntJob 主库、扩展库与数据模型在裁剪后仍可加载、翻译与调度。</Description>
    <Company>新生命开发团队</Company>
    <Copyright>版权所有(C) 新生命开发团队 2026</Copyright>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AntJob\AntJob.csproj" />
    <ProjectReference Include="..\..\AntJob.Extensions\AntJob.Extensions.csproj" />
  </ItemGroup>

</Project>
