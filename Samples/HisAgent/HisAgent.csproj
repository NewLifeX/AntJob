<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyTitle>蚂蚁调度 HisAgent 示例</AssemblyTitle>
    <Description>基于依赖注入接入调度中心，注册多个作业处理器的示例执行端。</Description>
    <Company>新生命开发团队</Company>
    <Copyright>版权所有(C) 新生命开发团队 2026</Copyright>
    <VersionPrefix>1.0</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <AssemblyVersion>$(VersionPrefix).0.0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).$(VersionSuffix)</FileVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\..\Bin\HisAgent</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="JobHost.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AntJob.Extensions\AntJob.Extensions.csproj" />
    <ProjectReference Include="..\..\AntJob\AntJob.csproj" />
    <ProjectReference Include="..\HisData\HisData.csproj" />
  </ItemGroup>

</Project>
