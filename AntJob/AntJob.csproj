<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;netstandard2.0;net461;net45;net8.0</TargetFrameworks>
    <AssemblyTitle>AntJob SDK Library</AssemblyTitle>
    <Description>AntJob distributed task scheduling SDK: high-throughput job slicing, reliable retries and elastic scaling across worker nodes. NativeAOT-ready, with built-in runtime localization; targets .NET Framework 4.5, .NET Standard 2.0/2.1 and .NET 8.0.</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 NewLife</Copyright>
    <VersionPrefix>5.1</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(VersionPrefix).$(VersionSuffix.Split('-')[0])</FileVersion>
    <AssemblyVersion Condition="'$(Deterministic)' == 'true'">$(VersionPrefix).0.0</AssemblyVersion>
    <AssemblyVersion Condition="'$(Deterministic)' != 'true'">$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  
  <PropertyGroup>
    <PackageId>NewLife.$(AssemblyName)</PackageId>
    <PackageDescription>AntJob distributed task scheduling SDK: high-throughput job slicing, reliable retries and elastic scaling across worker nodes. NativeAOT-ready, with built-in runtime localization; targets .NET Framework 4.5, .NET Standard 2.0/2.1 and .NET 8.0. 蚂蚁调度 SDK：分布式任务调度核心库，提供高吞吐量的任务切片、可靠重试与弹性伸缩能力；原生 AOT 就绪，内置运行时多语言消息；单包覆盖 .NET Framework 4.5 至 .NET 8.0 共 5 个目标框架。</PackageDescription>
    <Authors>$(Company)</Authors>
    <PackageProjectUrl>https://newlifex.com/blood/antjob</PackageProjectUrl>
    <PackageIcon>ant.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/AntJob</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>新生命团队;X组件;NewLife;AOT;NativeAOT;本地化;$(AssemblyName)</PackageTags>
    <PackageReleaseNotes>原生 AOT 就绪，AOT/裁剪分析器 0 告警，泛型处理器注册补齐裁剪标注；HTTP 通道完整化，客户端按地址自动选择 HTTP 或 TCP RPC，直接对接 AntWeb 无需独立服务端；新增 WebSocket 下行通知并支持断线补偿拉取；新增 UseRegistry 注册中心解析开关与 MessageIdlePeriod 空闲周期配置；上报幂等与锁超时保护，重复或乱序上报不再污染统计；调度循环多作业并行申请，动态处理器按名称建索引；内置 11 种语言运行时词表，包描述中英双语；依赖对齐 NewLife.* 2026-10-24 最新正式版</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(TargetFramework)' == 'net461'">
    <!-- C#脚本组件仅提供 netstandard2.0 资产，其依赖在 net461 下会触发 TFM 支持性警告，实际通过 netstandard 兼容层加载 -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1024" />
    <PackageReference Include="NewLife.Remoting" Version="4.0.2026.1024" />
    <PackageReference Include="NewLife.Stardust" Version="3.10.2026.1024" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" Condition="'$(TargetFramework)' != 'net45'" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="..\Doc\ant.png" Link="ant.png" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
